ـزويـــر الـم{سنــدة لــلأخــيــــر، وذلك ب�أن اتفقا على اختال6س مبالغ مالية\nمن الـحــ{ساب العام لوزارة ....، و6ساعده على ذلك باعتماده ومتريره جمموعة\nمن ال{سندات الإلـكـتـــرونـيـــة الـمـخالــفــة للـحـــقيـقـــة، عن طـريـــق اعتمادها\nفــي النـظـام الـمـالـــي الإلكــتــــرونــي بدائرة التدقـيــق الداخلـي، دون وجود\n�أي 6سندات �أو مــ�ؤيدات لها، و�إر6سالها �إلـكـتــرونـيـًّا �إلـى وزارة الـمالـية للتح}صيل\n\n– 368 –\n على الـمبالـغ الـمالــيـة متـهــيـــــدًا الخــتـال6سها، ف~ ضلاً عن منعه التدقيــق على\nالـحـ{ســاب الـعـــام للــــوزارة، وعـــدم اعــتـــرا9ضـــــه على 6سند ت{سوية ال{سلفة\nرغم ثبوت علمه باحتوائـــه على بيانات مــــزورة، الأمر الذي مكَّنَ الـمــتــهميـــــن\nالأول والثاين من اال6ستيالء على الـمبالغ الـماليـــة حمـل جريـمــة االختال6س،\nوفـــق الثابت بالتحقيقات، وبك|شف ال|شيــكــــات الــمــــزورة الـمـرفـــــق.\n\t ا6سـتــخـــدم و6سيلة تــقــنــيـــــة مــعـــلومـــات الرتكاب جرمية تزوير مــعــلوماتــي -2\n يف البيانات والـمعلومات الإلـكتـــرونـيـــة الـحــكومــيـــة، وذلك ب�أن اعتمد 6سندات\nال}صرف حمل جرمية االختال6س فـي النظام الـمـالــي الإلــكـتـــرونـي الـتـابـــع\nلوزارة الـماليـــة، دون �أن يكون لها مــ�ؤيــدات حقيــقية و8صــحـيـحـــة، ب}صفته\nالـموظــف  الـمـعـنــــــي  باعتماد  6سندات  ال}صرف  بدائرة  التدقيق  الداخلـــي\nبــوزارة .....، وحول تلك ال{سندات بعد اعتمادها �إلـى وزارة الـمـالــيـــــة، وفــق\nالثابت بالتحقيقات.\n\t�أخــــلَّ بواجباته الــوظيفية لـجـلــب منــفعــة له ولــغــيــــره، متثلت فـي متـكيـــن -3\n الـمـتــهمــيــــن (الأول والثاين) من اال6ستيالء على الـمبالغ الـمالية حمل جرمية\nاالختال6س، وا6ستالمـــه هو 7شخ}صيًّا جزءًا من تلك الــمبالغ، وذلك حال ارتكـــابه\nلـلــجــرمــيـــــن �أولاً وثانيًا، وعدم اتخاذه �إجـراءات التدقيــق على ال}صرف من\nاحلـ{سـاب العام للوزارة، و�إ8صدار توجيـــهـاتــه مبنع ذلك، مع علمه بوجود العديد\nمن ال{سندات الـمعتــمــدة من دائرة التدقـيــق الداخــلـــــي فـي النظام الـمالــي\nبالـمخالفة لنظام التدقـيــق، وفــق الثابت بالتحقيقات.\n\t حــال ارتــكــابــــه للــجــرمــيـــــن �أولاً وثانيًا، تعدى على الـمال العام ومل يراعِ -4\n.حرمته والـمحافظـة عليه، وفق الثابت بالأوراق\nرابعًا: بالن{سبة للمتهم الرابع/.....:\n  م{ساعــد  مـديـــر  دائــرة  الـتــدقيـــق  الــداخـلــــي -  \t ب}صـفـته  مـوظـفـًا  عامًـّا-1\n  ا7شتــرك باالتفاق والـم{ساعـــدة مــع الـمتــهـم الأول فـي ارتـكــاب- ..... بوزارة\nجـرمية  االختال6س  بـالـتــزويــر  الـم{سنــدة  للأخـــيــر،  وذلك  ب�أن  اتفقا  على\nاختال6س  مبالغ  مالية  من  احل{ساب  العام  لــــوزارة  .....،  و6ساعـــده  فـي  ذلك\nباعــتــمــــاده وتــمــريــــره جمموعة من ال{سندات الـمخالفــة للحــقــيــقـــة يف\nالنظام الـمـالــــي الإلـكـتـــروين بدائرة التدقـيــق الـداخــلـــــي، دون �أن يكون لها\n\n– 369 –\n مـ�ؤيـــدات حقيــقــيــة وفـعـلـيــة، ف~ ضلاً عن توقيــعه خـــالفــًا للحقـيقـة تقرير\nم، الأمــر 2018 تــ{ســويــة 6سلــفـــتـــــي رواتب 7شهري نوفمبــر ودي{سمـبـــر من عام\nالذي مكَّنَ الـمتــهـمــيـــــن الأول والثاين من اال6ستيــــالء على الـمبـالــغ الـمــالــية\nحمل جرمية االختال6س، وفق الثابت بالتحقيقات تف}صيلاً ، وبك|شف ال|شيكـــات\nالـمــزورة الـمـرفــــق.\n\t حـال ارتكـابه للـجرم حمل التـهــمة الأولــى، زوّر مـحــررات ر6سميــة عبارة عن -2\n (تقريري  ت{سوية  6سلفتـــي  الرواتب  ل|شهري  نوفــمـبـــر  وديـ{ســمــبـــر  من  عام\nم)، وذلك بجعل واقـعة مـــزورة فـي 8صـــورة واقعة 8صـحيحــــة مع علمه 2018\n بــتــزويــرها، حيث وقــع تقريري ت{سوية م}صروفات 6سلفتـــي الــرواتب 6سالفة\nالذكر، و�أثبــــــت بــهما خـــالفــــًا للحــقيقـــة 8صرف مبالغ مالية بالزيادة بلغت\n) خم{سة مـــالييـــن وت{سعة وع|شرين �ألفـًا وثمامنائة وت{سعة 5.029.879.159(\n و6سبعــني ريالاً عمانيًّا ومــائــــة وت{سعًا وخم{سني بي{سة، كـــرواتب لـموظفـــي\nالوزارة بـخـــالف الــم}صروف فعليًّا للرواتب من ال{سلفتيـن، بهدف اختال6س تلك\nالـمبالغ وتغطيــة قيمة االختال6سات ال{سابقة، وفق الثابت بالتحقيقات.\n\t حـال ارتــكــابــه لـلــجــرمــيـــــن �أعــاله، ا6ستعمل الـمحـــررات الر6سمية الـمــزورة -3\n 6سالفة  الذكر  مع  علمه  بـتـــزويــــرها،  وذلك  ب�أن  6سلـمهـــا  للمــوظفـــيــــن\nالـمعــنــيـيـن  بـــــوزارة  .....  بق}صد  عــر9ضـها  علـى  معالــي  (الوزير.....)\nلالعـتــمـــاد الـنــهـــائــــــي و�إحـالــتــهــــا بعد ذلك لوزارة الـمــالــيـــــة، الأمــــر\nالثابت بالتحقيقات.\n\t ا6سـتــخدم و6سيلة تقنـــية مـعــلومات الرتــكـــاب جرمية تــزويـــر معــلوماتــي فـي -4\n البيانات والـمعلومات الإلـكـتـــرونية احلـكــومــــية؛ وذلك ب�أن اعتمد 6سـنـدات\nالـ}صـرف مـحـل جــريـمــة االختال6س فـي النظام الـمـالــي الإلـكـتـــرونــي التابع\nلــوزارة الـمالية، ب}صفته الـموظـف الـمـعــنـــي باعتماد 6سندات ال}صرف بدائرة\nالتدقيق الداخلـي بوزارة .....، وحولها بعد اعتمادها �إلـى وزارة الـماليـــة،\nلتقوم الأخيــــرة ب�إيــداع قيمة تلك ال{سندات فـي احل{ساب البنكــــي العام لــوزارة\n.....، ليتمكنوا بعد ذلك من اختال6ســـها، وفـــق الـثـابــت بالتـحــقــيــقـــــات.\n\t�أخلَّ بــواجباته الـوظيفية، لـجــلـــــب منفعة له ولغيـــره، متثلت فـي تـمـكـيـــن -5\n الـمتــهــمــيـــــن (الأول والثاين) من اال6ستيــالء على الـمبـالغ الـمـاليــة حمل\n\n– 370 –\n جرمية  االختال6س،  وا6ستالمــه  هو  7شخ}صيًّا  جزءًا  من  تلك  الـمبالغ،  وذلك\nحال ارتـكــابه للـجـرائم �أولاً وثانيًا وثالثًا، وتوقيعه 6سند 8صرف 6سلفة رواتب\nموظفــي وزارة ..... لــ|شــهـــر نوفمرب وديــ{ســمـــبـــــر و�إثباته خالفـًا للحقيقة\nوجود عـجــز ببند رواتب موظفــي الــوزارة، ف~ ضلاً عن ت{سليمه الـرمز الــ{ســري\nالـمخ}ص}ص ال6ستالم واعتماد ال{سندات فـي النظام الـمـالـي بدائرة التدقــيــق\nالداخــلــــي للمتــهم الأول، وفق الثابت بالتحقيقات.\n\t حـــال ارتــكـابـه للـجـرمـيــن �أولاً وثانيـًا، تعدى على الـمال الـعـام ومل يراعِ -6\n.حـرمـتــه والـمـحافظــة عليه، وفق الثابت بالأوراق\nخام{سً ا: بالن{سبة للمتهمة اخلام{سة/ .....:\n رئي{س ق{سم الـم}صروفات الـمتكـررة بدائرة الإيــرادات - \t ب}صفتها مـوظفــًا عـامـًّا-1\n  ا7شتـركــت باالتـفاق والـم{ساعـدة مــع الـمتــهــم- ..... والـم}صروفات بوزارة\nالأول  فـي  ارتــكــاب  جريــمـــة  االختال6س  بالـتــزويــر  الـم{سنــدة  للأخـيـــر،\nوذلك ب�أن اتفقا على اختال6س مبالغ مـالـيــة من احل{ساب العام لـــوزارة .....،\nو6ساعــدته على ذلك ب�أن �أمدته ب�أرقــام 6سندات الـ}صرف من الـ{سـجــل الـيــدوي\nو�أدخـــلــتـــها فـي النــظـــام الـمــالـــي الإلــكـــتــــرونـــي التابع لــوزارة الـمالية\nدون وجود �أي مــ�ؤيـدات لل}صرف، الأمـر الذي مكَّنَ الـمتــهــم الأول من حتــرير\nو6سـحـــب  الـ|شـيكـــات  مـحــل  جريــمة  االخــتال6س،  واال6ستــيالء  على  الـمبالغ\nالـمبــينة بو8صف التـهـــمــة الأولـى، وفــق الثابت بالتحقيقات.\n\t حـال ارتكــابــها للجرم حمل التــهمة الأولـى، زوَّرت حمررات ر6سمية عبارة عن -2\n جمموعة من ال|شيكــات الـمحررة با6سم الـمتهم الثامن (.....)، والـم{سـحوبـة\nعلى البنك .....، من ح{ساب وزارة .....، وذلك بـتـغـــيــيــر احلقيقة بجعل\nواقعة مزورة فـي 8صورة واقعة 8صـحـيحـة مع علمها بعدم 8صـحـتــها، حيث وقعت\n) 7شيـكــًا من ال|شيكــات الـمحـررة با6سم الـمتـهم الثامــن (.....)، على �أنها 76(\n ،م{ستحقة الدفع خــالفـًا للحـقيقـة، وبدون �أي 6سندات �أو مــ�ؤيــدات لل}صرف\nوفق الثابت بالتحقيقات، وبك|شف ال|شـيــكـــات الـمزورة الـمرفــق.\n\t وحال ارتكـابها للـجـرم حمل التـهـمـة الأوىل، زوَّرت حمررات ر6سمية عبارة عن -3\n م)، وذلك2018م، و2017م، و2016 (6سـجـل 6سندات ال}صرف اليدوي للأعوام\nب�أن دونت بيانات خمالفة للحقيقة، يف بع~ض �أوراق 6سـجـالت ال{سندات 6سالفة\n\n– 371 –\n ،).....( الذكر، وتـحـديـدًا قرين �أرقام ال{سندات الـتـي 6سلمتـها للمتـهم الأول\nوحُ ررت بها ال|شـيـكــات حمل جرمية االخـتـال6س با6سم الـمتـهم الثامن (.....)،\nم)،  فـي  6سـجـل 2018/4828(  :ف~ ضلاً  عن  قيامها  ب|شطب  بيانات  ال{سند  رقم\nم، ودونت عليه عبارة (مـلـغــى)، على الرغم من �أن 2018 ال{سنـدات الـخـا8ص بعام\nال{سند 6سالف الذكر 8صُ رِفَت به جمموعة من الـ|شـيـكـات حمل جرمية االختال6س\nبا6سم الـمتـهم الثامن (.....)، ووقعت الـمتـهـمـة 7شخ}صيًّا على بع~ض منه، وفق\nالثابت بالتحقيقات، وببيــانات �أرقام ال{سندات الواردة بتقرير خمتبــر التـزوير\nوالتـزييف.\n\t وحال ارتـكـابـها للـجـرم حمل التـهـمـة الأولـى، زوَّرت �أي~ضً ا مـحـررات ر6سمية -4\n عبارة عن (تـقرير ت{سوية 6سلفـتـــي الرواتب لـ|شـهـــري نوفـمـبـــر وديـ{سـمـبـر من\nم)، وذلك بـجعلهـا واقعة مزورة فـي 8صورة واقعة 8صـحيـحــة مع علمها 2018 عام\nبـتــزويـرها، حيث قامت بتفريغ بيانات �أ8صل تقرير ت{سوية م}صروفات 6سلـفـتــــي\nالــرواتب لـ|شـهـــري نـوفـــمـــبــــر وديـ{ســـمــبــــر من العام 6سالف الذكر، و�أثبتت\nبـهما خـــالفــًا للــحقيــقة 8صرف مبالغ مالية بالزيادة كــــرواتب لـموظــفـــي\n) خم{سة مـــاليـــيـــــن وتــ{ســعـــة وعـــ|شــــرين 5.029.879.159( الوزارة بلغت\n�ألـــفـًا وثــمــــانـــمـــائــــة وتـــ{ســــعــــة و6ســبـــعـــني ريــالاً عمانيًّا ومائة وتــ{سـعًا\nوخــمــ{ســـني  بــيـــ{سة،  بــخالف  الـم}صروف  فعــليًّا  للرواتب  من  ال{سلـفــتــيـــن،\nالأمـــر الثابت بالتحقــيـــقات تــفـــ}صـــيـــلاً .\n\t حــال ارتكـــابــها للــجــرائم (�أولاً وثانيًا وثالثًا)، ا6ستعملت الـمحررات الر6سمية -5\n الـمزورة 6سالفة الذكر ب�أن مــررتــها كال فـي دورته ليتم تقديـمـها �إلـى البنك\n.....  و�إلـى  وزارة  الـمــاليـــة،  مع  عــلــمــها  بــتـــزويـــرهــا،  الأمر  الذي  مكَّنَ\nالـمـتــهـمـيـــن الأول والثاين من اال6ستيالء على الـمبالغ الـمالية حمل االختال6س،\nوا6ستالمـــها هـي 7شخ}صيًّا جزءًا من تلك الـمبالغ، وفــق الثابت بالأوراق.\n\t ا6سـتــخدمــت  و6سيلة  تقنية  معلومات  الرتكاب  جرمية  تزوير  معلوماتي  فـي -6\n البيانات والـمعلومات الإلكتـرونية احلكومية، وذلك ب�أن �أعدت 6سندات ال}صرف\nحمل جرمية االختال6س فـي النظام الـمالــي الإلــكــتـــرونـــي الــتــابـــع لوزارة\nالـمالية،  ب}صفتــها  الـموظـــف  الـمــعــنــــي  ب�إعـــداد  6سندات  ال}صرف  بق{سم\nالـم}صروفات الـمتكـررة بوزارة .....، على الرغم من علمها بعدم 8صـحـة بيانات\nال{سندات الـتـي �أدخلتــها فـي النظام الإلـكــتـــرونــي، ل}صدورها من غـيــر �أي\n\n– 372 –\n م�ؤيدات �أو 6سندات، وحــولــتـــها بعد �إنـ|شـائــها فـي النظام �إىل دائرة التدقـيــق\nالـداخــلــــي متـهــيــــدًا العتمادها و8صرفها، وفق الثابت بالتحقيقات.\n\t غــ{ســلت �أموالاً غــيـر مــ|شــروعـــة الـمـ}صــدر، تعــلـــم ب�أنها عـــائـــــدات جــــرمية -7\n االختال6س مـــحـــل الــقــــرار، وذلك ب�أن متلكت وا6ستخدمت وحـــولت الأموال\n  بق}صد -  ًا  مـحل  االتــهــام �أول-  الــمتــح}صل  عليـــها  من  جرمية  االختال6س\nمتويه و�إخــفاء طبيعة وحركــة ومــلكيـــة ومــ}صـــدر تلك الأمـــوال غـــيـــــر\nر.ع) 30,400( الـمــ|شــروعــــة، حيث حول لها الــمتـــهم الأول (.....) مبلغـًا قدره\nثالثون �ألفـًا و�أربعمائة ريال عماين، كما حول لها الـمـتـهـم ال{ساد6س ع|شر بناء\n ر.ع) ثمانية وثالثون �ألف ريال 000 .38( على �أمر الأخــيـــر، مبلغـًا وقدره\nعماين، وا6ستخدمـــت تلك الأموال فـي 7شراء �أر9ضيــن لال6ســتــخدام الـ{ســكــنـــــي،\nوحولت جزءًا �آخــر ل{ســداد قــــر9ضــــهــا الــبــنــكـــــي، الأمــر الذي كــ|شـــفــــت\nعـــنــــه التــحـقيقات تف}صيلاً .\n\t�أخلـت  بواجـبـاتها  الوظيفــيـة  لـــجــلــــب  مـــنــفــعــــة  لـــهــــا  ولـــغـــيـــــــرها، -8\n متـــثــلـــت فـي متكيـــن الــمتــهــميــــن الأول والثاين من اال6ستـيـــالء على الـمبالغ\nالــمالــية مـحـل جـرميــة االختال6س، وا6ستالمــها هـي 7شخ}صيًّا جزءًا من تلك\nالأمــوال،  وذلك  حال  ارتــكـــابــها  للــجـــرم  من  الــثــانـــي  وحتـــى  ال{ساد6س،\nف~ ضلاً عن قيامــها ب�إعطاء الـمتـــهم الأول �أرقام 6سندات من ال{سـجـــل الــيـــدوي\nلــــ{سنـــدات ال}صرف دون وجـــود �أي مـــ�ؤيـــــدات، وفـــق الثابت بالتحقيقات.\n\t حـال ارتكــابـها للــجــرمـيـــن �أولاً وثانيًا، تعدت على الـمـال الـعــام ومل تراعِ -9\n.حــرمــتـــه والـمـحافــظـة عليه، وفق الثابت بالتحقيقات\n6ساد6سً ا: بالن{سبة للمتـهـم ال{ساد6س/.....:\n  رئـيــ{س  قــ{ســم  الإيــرادات  والـم}صروفات  بوزارة -  \t بـ}صفــته  مــوظفـًا  عامًّا-1\n  ا7شتـرك باالتفاق والـم{ساعدة مـع الـمتـهم الأول يف ارتكاب جـريـمـة- .....\n االختال6س بالـتـــزويـــر الـمـ{سـنـــدة للأخـــيــــــر، وذلك ب�أن اتفقا على اختال6س\nمـبـالـغ مـالـيـــة من الـحــ{ســاب العام لــوزارة .....، و6ساعده ب�أن قام بــطبـــاعــــة\nال|شــيـــكــــات مـــحــــل الــجــرمية با6سم الـمتــهـــم الثامــــن (.....)، ووقع على\nجزء منــها، دون وجود �أي 6سندات �أو م�ؤيدات للـ}صــرف، ف~ ضلاً عن تــحــريــره\nبــيـــــانـــي  الــمــبـــالـــغ  الــمــ}صــروفــــة  من  6ســلـــفـــتــــي  الـــرواتب  ل|شــهـــري\n\n– 373 –\n م، و�أثبــت بــهما خـــــالفـــًا للحقـيقة2018 نــوفـــمــبــــر وديـــ{ســــمــــبـــــر من عام\n8صـرف مــبــالـــغ مـــالــيـــة بالزيادة كـــرواتــب لـمــوظـــفـــــي الوزارة، بــخـــالف\nالــم}صـــروف فـعــليـًّا للرواتب من الـ{سلفــتــيــــن، الأمر الذي مكَّنَ الــمتــهــمــيــــن\nالأول والثاين من اال6ســتــيـــالء عــلـــى الــمبالــغ حمل االختال6س، وفـــق الثابت\nبالتحقيقات.\n\t حـــال ارتــكـــابـــه للــجــرم مــحـــل التـــهــمــــة الأولـــى، زوّرَ مــحــررات ر6سـمـية -2\n ،).....( عبارة عن جمموعة من ال|شيـكــات الـمحــررة با6سم الـمتــهـــم الثامــــن\nوالـم{سحوبة  على  البنك  .....،  من  ح{ساب  وزارة  ......،  وذلك  بطباعة\nالــ|شــيــكــــات مــحــل جرمية االختال6س، و�إ9ضافة بــيــانات غــيــــر 8صــحــيحة\nعليــها، وبتـغـييــر الـحقيـقة فـي تلك البيانات بجعل واقعة مــزورة فـي 8صورة\n) 7شـيــكـــات 110( واقـعـة 8صـحيــحــة مع علمه بعـدم 8صـحـتــــها، حيث وقــع\nمن ال|شيــكـــات الـمحررة با6سم الـمتــهـــم الثامــــن (.....)، على �أنـها م{ستـحقة\nالدفع خـالفـًا للحـقيـقـة، وبدون �أي 6سندات �أو م�ؤيدات لل}صرف، وفق الثابت\nبالتحقيقات، وبك|شف ال|شـيـكـات الـمزورة الـمرفــق.\n\t وحـــال  ارتــكـــابـــه  للــجــرم  مــحـــل  التـــهــمــــة  الأولـــى،  زوّرَ  مـحـررات -3\n ر6سمــيــة عـبـارة عن (تقريري ت{سوية 6سلـفـتــي الرواتب لـ|شـهـــري نــوفـــمـــبـــر\nم)، وذلك بجعل واقعة مزورة فـي 8صورة واقعة 2018 وديــ{ســمــبــــر من عام\n8صـحـيحـة مع علمه بـتـــزويـــرها، حيث حـرر بيــانـي الـمــبــالــغ الـمـ}صروفــة\nمن 6ســلــفــتـــــي الـــرواتـب لـــ|شـــهـــــري نـــوفـــمــــبــــر وديـــ{ســـمــــبـــــر من عام\nم، و�أثــبــت خـــالفـــًا للـحـقــيقــة 8صــرف مــبــالــغ مــالية بالزيادة كـــرواتب 2018\n ،لـموظفـــي الــوزارة، بـخـالف الـم}صـــروف فعــلــيــا للرواتب من ال{سلفــتـــيـــــن\n) خــمــ{ســة مـــاليـــيـــــن وتــ{ســعـة وعــ|شرون 5.029.879.159( مببلغ وقدره\n�ألفًا، وثــمــامنــائـــــة وتــ{ســعـــة و6ســبــعون ريالاً عمانيًّا ومائة وت{سع وخم{سون\nبي{سة، الأمــر الــثــابــــت بالتحــقــيــقـــــات.\n\t حـــال ارتكابه لـلـجـرمني ثــانـــيــــًا وثــــالــــثــــًا، ا6ستــعمل الـمــحـررات الر6ســمـــية -4\n الـمـــزورة 6سالفة الذكر، ب�أن 6سلم ال|شيكات حمل الـجــريــمــة لـلـمتــهـــم الثامــــن\n(.....)، متـهـيــدًا لـتـوقيــعـــها وتـقــدميــهـــا �إىل الــبــنـــك الـوطــنـــي العماين\nلل}صرف،  وكذلك  ت{سليـم  بيانـي  الـ{ســلــفـــة �إىل  الــمعنـيــيـــــن  بــــوزارة  .....\nالعــتــمــادها مع علمه بــتــــــزويــــرها، وفـــق الـــثـــابــــت بالأوراق.\n\n– 374 –\n \t ا6ســتــخدم و6ســيـــلة تــقــنــيـــة الـمــعلومات الرتكاب جرمية تـزوير مـعـلـوماتـي-5\n فـي  البيانات  والـمعلومات  الإلكتـرونية  احلكـومية،  بـتـخـزيــنــــه  خـالفـًا\nللحــقيــقـة �أرقام  الـ|شيــكـــات  وبياناتها  مـحل  جــرمية  االختال6س  فـي  نظام\nال|شـيــكـــات التابع لوزارة الــتـــربــيــــة والتــعليـــم، عـلــى الرغم من علمه بعدم\n8صـحـــة تلك البيانات، و8صدورها بدون �أي 6سندات �أو مــ�ؤيدات، وفـق الثابت\nبالتحقيقات.\n\t حــال ارتــكـــابــــه لــلـــجـــرمـــيـــــن �أولاً وثانيًا، �أخـــل بــواجباتــه الــوظــيــفــيـــة -6\n لـجـلــب  مـنـفعــة  له  ولــغــيــــره،  متثلت  فـي  تـمكــيــــن  الـمتــهـمــيــــن  (الأول\nوالثاين)، من اال6ستــيــــالء على الـمبالـغ الـمـالــيـــة مـحــل االختال6س، ف~ ضلاً عن\nا6سـتــالمـــه 7شخ}صيًّا جزءًا من تلك الـمبالــغ، وفــق الـثابــت بالتــحقيــــقات.\n\t حـــال ارتـــكــــابــه لــلــجـــرمــيــــن �أولاً وثانيــًا، تعدى على الـمـال العام ومل -7\n.يــراعِ حـرمـتـه والـمـحافظـــة عليه، وفق الثابت بالأوراق\n6سابعًا: بالن{سبة للمتهمة ال{سابعة/.....:\n مــ{سـاعـد مـديـــر دائرة الإيــرادات والـمـ}صروفـــات - \t ب}صفتــها مـوظــفـــًا عـــامــــًا-1\n  ا7شتـركت باالتفاق والـم{ساعدة مع الـمتــهم الأول فـي ارتـكـاب- ..... بـــوزارة\nجــرمية االختال6س بالــتـــزويـــر الـمـ{سنــدة للأخـــيــــر، وذلك ب�أن اتفقا على\nاختال6س مـبــالغ مـالــيــة من الـحـ{ساب العام لوزارة .....، و6ساعــدتــه بتوقيــعـــها\nعلى بـعـ~ض ال|شـيــكـــات حمل جرمية االختال6س، وتقريري تــ{ســويــة 6ســلـــفــتـــــي\nم، حيث �أثبتت بهما 2018 رواتــب 7شــهـــري نـوفــمـــبــــر وديــ{ســمــبـــر من عام\nخــالفـــًا للحقيـقة 8صرف مبالغ مالية بالزيادة كـرواتب لـموظفـي الوزارة مببلغ\n) خم{سة ماليـيــن وت{ســعة وع|شرون �ألفًا وثمامنائة 5.029.879.159( قدره\nوت{سعة و6سبعون ريالاً عمانيًّا ومـائة وت{سع وخم{سون بي{سة، بخالف الـم}صروف\nفعـليــًّا للرواتب من ال{سلـفــتــيـــن، الأمر الذي مكَّنَ الـمـتــهمــيـــن الأول والثاين\nمن اال6ستيالء على الـمبالغ حمل االختال6س، وفق الثابت بالتحقيقات.\n\t وحــال  ارتــكــابــها  للـجرم  حمل  التــهــمـة  الأولـى،  زوّرت  حمررات  ر6سمـيــة، -2\n عبارة  عن  مـجـمـوعــة  من  ال|شيــكـــات  الـمحررة  با6سم  الـمتــهـــم  الثامــــن\n(.....)، والـم{سـحوبة على البنك.....، من ح{ساب وزارة .....، وذلك بتـغــييـــر\nالــحقيــقة بجعل واقــعة مــزورة فـي 8صورة واقـعة 8صـحــيحـة مع علمها بعدم\n\n– 375 –\n )  7شـيـكـــًا  من  الـ|شيــكـــات  الـمـحررة  با6سم32(  8صـحتــها،  حيث  وقعت  عدد\nالـمتــهـــم الثامــــن (.....)، على �أنـها م{ستحقة الدفع خــالفـــًا للحقــيقة، وبدون\n�أي 6سندات �أو مــ�ؤيدات لل}صرف، وفق الثابت بالتحقيقات، وبـكـ|شــف ال|شـيـكـــات\nالـمزورة الـمرفـــق.\n\t حـــال ارتــكـــابــها للــجــرم مــحــل الــتــهــمــة الأولــــى، زوّرت مــحــررات ر6سمــيــة، -3\n عــبارة  عن  (تــقــريـــري  تــ{ســويــة  6ســلــفــتــي  الرواتب  ل|شهــري  نوفــمــبــــر\nم، وخـــطاب موجه لــجــهــــاز الـــرقــابـــة الـــمــاليـــة 2018 وديــ{ســمــبـــــر من عام\nوالإدارية)، وذلك بجعل واقـعــة مــزورة فـي 8صورة واقــعــة 8صــحــيـــحـــة مع\nعــلـمــها بــتــــزويـــرها، حيث وقعت تــقــريـــري ت{سوية م}صروفات 6سلــفــتـــــي\nالرواتب لــ|شـهري نــوفــمـــــبــر وديــ{ســـمـــبــــر من العام 6ســالـــف الذكر، بعد �أن\n�أثــبــتـــــت بــهما خـــالفـــًا للــحـقيقة 8صرف مـبالغ مـالية بـالزيــادة كــرواتب\nلـموظــفــــي الـــوزارة، بــخـــالف الـمــ}صروف فعلــيًّا للرواتب من الــ{سلفــتـــيــــن،\n) خـمـ{سة مــاليــيـــن وتـ{ســعة وعــ|شرون �ألفا 5.029.879.159( مببلغ قدره\nوثمامنائة وتــ{سعـة و6سبـعون ريالاً عمانيًّا ومائة وت{سع وخم{سون بي{سة، وفـــق\nالـثــابـــت بالتحقـــيقات تف}صيلاً .\n\t حـال ارتــكــابـها للـجـرم حمل التــهـمـة الأولـى، زوّرت مـحـررًا ر6سمـيــًا، عبارة عن -4\n خطاب موجه لـجـهــاز الرقابة الـمالية والإدارية للدولة، وذلك بجعل واقعة\nمزورة فـي 8صورة واقــعة 8صــحــيحـــة مع عــلـمـــها بــتــــزويـــرها، حيث وقعت\nعلى اخلطاب 6سالف الذكر، بعد �أن �أثبتت خـــالفــــًا للــحقيــقة �إلغاء ال{سند\nم)، فـي حيـن �أن ال{سند 6سالف الذكر مت 8صــرفه وتــحـريـر 2018/ .....( :رقم\n�أكرث من ثـــالثة 7شــيـــكــــات عــلــيـــه، الأمـــر الــثـــابت حتقــيــقـــًا.\n\t حـــال ارتــكـــابــها للــجـــرائم �أولاً وثانيـًا وثالثًا، ا6ستعملت الـمحررات الر6سمية -5\n ،..... الـمزورة 6سالفة الذكر ب�أن قدمـتـها وفق دورتــها الــالزمــــة �إلـى البنك\nو�إلـى وزارة الـمالـيــة، وجــهــاز الرقابة الــمــالــيــة والإدارية للدولة مع علمها\nبــتــزويــرها، وفق الثابت بالأوراق.\n\t حــال ارتــكـــابـــها للــجــرائم �أولاً وثانيـًا وثالثًا ورابعًا، �أخـلــت بـواجــبــاتــها -6\n الــوظيــفــية لــجـــلـــب مــنفعة لــهـــا ولــغــيــــرها، متثلت فــي متكيـــن الـمتـهمـيــــن\nالأول  والثاين  من  اال6ستيالء  على  الـمبالغ  الـمختل{سة،  ف~ ضلاً  عن  ا6ستالمــها\n\n– 376 –\n.7شخ}صيًّا جزءًا من تلك الأمـــوال، وفق الثابت بالتحقيقات\n\t حــال ارتــكـــابــها للــجــرمــيــــن �أولاً وثانيًا، تعدت على الـمال الـعــام ومل تــراعِ -7\n.حــرمته والـمحــافظـة عليه، وفق الثابت بالأوراق\nم 2020/ 1025 ثامنًا: بالن{سبة للمتهم الثامن/..... (الطاعن) يف الطعن رقم\n ا7شـتـــرك باالتـفـاق والـمـ{ساعدة مع - ..... \t بـ}صفــته مــوظفــًا عامـًا بوزارة-1\n الـمـتـهم  الأول  فـي  ارتــكـــاب  جريــمــة  االختال6س  بالــتـــزويــــر  الـم{سنــدة\nلــلأخــيــــر، وذلك ب�أن اتـفــقا على اختال6س مبالغ مــالية من الــحــ{ساب الــعـام\nلـوزارة .....و6ســاعــده بــقــبـــولــه تــحــريـــر الــ|شــيـــكــــات مــحــل االختال6س\nبا6سمه على الرغم من عدم 8صــحــتـــها، و8صـرفــها من الــحــ{ساب العام للوزارة،\nوتـ{ســليــمـــها نــقـــدًا لــلــمــتــــهم الأول، �إمـــا بــ�إخــفــائــها فـي مـركبـــتـــه �أو\nبــداخـــل مـــكــــتبـــه، وفق الثابت بالتحقيقات.\n\t حــال  ارتــكــابــه  لـلــجــرم �أولاً ، �أخــل  بـــواجــبــاتــه  الوظيــفــيـــة  لــــجــلـب -2\n مــنفعــة لــه ولــغــيــــره، تــمـــثـــلــت فـي تـمــكــيـــن الـمتــهمــيـــن الأول والثاين\nمن  اال6ستيالء  على  الـمبـالغ  الـمختــل{سة،  ف~ ضلاً  عن  ا6ســـتـــالمـــه  7شـخــ}صيـــا\nجزءًا من تلك الأموال، وفق الثابت بالتحقيقات.\n\t حــال ارتــكــــابه للــجـــرم �أولاً ، تــعـــدى عــلـــى الـمـال الـعـام ولـم يـــراعِ حــرمــته -3\n.والـمـحافظة عليه، وفــق الـثــابــت بـالأوراق\nتا6سعًا: بالن{سبة للمتهم التا6سع/.....:\n مـ{سـاعد مـديــر دائــرة الـمـوازنـــة بـــوزارة ..... - \t ب}صفـته مــوظــفـــًا عــامــــًّا-1\n  �أخل عن ق}صد بالقيام بواجبات وظــيفــته، وذلك بتقديره 6سلفة رواتب-\n م،  بالزيادة  عن  الـحـاجـة2018  7شـهــري  نــوفـــمــــبــر  وديـــ{ســـمـــبـــــر  لعام\n) خم{سة 5.029.879.159( الفعلية لــرواتب موظــفــــي الوزارة، مببلغ قدره\nمـــاليــيـــن  وتــ{سعة  وع|شرون �ألفـًا  وثمامنائة  وت{سعة  و6سبعون  ريالاً  عمانيًّا\nومــائـــة وتــ{ســـع وخم{سون بي{سة، الأمـــر الذي 6سبب �إ9ضرارًا مب}صالــح الدولة\nمتثل يف 9ضياع الـمـال العام، وفق الثابت بالتحقيقات.\n\t حــال  ارتــكـــابــه  للــجــرم �أولاً ،  تــعـــدى  عــلــــى  الــمــال  الـعــام  ومل  يـــراعِ -2\n.حــرمـــتــــه والــمــحافظة عليه، وفق الثابت بالأوراق\n\n– 377 –\n ،...../عا7شرًا: بالن{سبة (ملجموعة املتهمني) ..... العا7شرة/.....، واحلادي ع|شر\nوالثاين ع|شر/.....، والثالثة ع|شر/.....، والرابع عـ|شـر/.....:\n\t بـ}صفتهم موظفني عموميني بوزارة ..... (املتهمة العا7شرة/ م{ساعد مدير دائرة -1\n ،الإيرادات والـم}صروفات، والـمتـهـم الـحـادي ع|شر/ رئي{س قـ{سـم الـخـزيـنـة\nوالـمتـهـم الثاين ع|شر/ رئـيـ{س قـ{سم الــرواتب، والـمتــهـمة الثالثة ع|شرة/\nرئي{سة  ق{سم  الـم}صروفات  الإمنائية،  والـمـتـهـم  الرابع  عـ|شــر/  مدير  عام\nالـ|شـ�ؤون الـمالية) �أهملوا عن ق}صد القيام بواجـبــاتــهم الـوظيــفــيـــة، وذلك �أن\nوقعوا على مــجمــوعــة من ال|شــيـــكـــات حمل اجلرمية با6سم الـمتــهـــم الثامــــن\n(.....) دون التــثبــت والت�أكــد من 8صــحــتــــها واالطــــالع على مــ�ؤيــداتــــها، مبا\nيتفق مع 8صـحــيــح الإجــــراءات الـمعـتادة، وفـــق الثابت بالتحقيقات، وبـكــ|شف\nالــ|شــيــكــــات الــمــــزورة الـــمـــرفـــــق.\n\t حـــال ارتــكـــابــهـم للــجـــرم �أولاً ، تــعــدوا عــلـــى الـمــال الــعـــام ومل يراعو -2\n.حـــرمــتــــه والـمحافظة عليه، وفق الثابت بالأوراق\n�أحد ع|شر: بالن{سبة للمتهم اخلام{س ع|شر/.....:\n�أهمل عن - .....  موظفا بق{سم الـم}صروفات بوزارة- \t ب}صفتــه مــوظــفـــًا عـــامـــًّا-1\n ق}صد فـي القيام بواجـبــاتــه الوظيفية، ذلك ب�أن �أمد الـمتــهم الأول ب�أرقام\n6سندات  من  ال{سـجــل  الــيـــدوي  ل{سندات  ال}صرف،  دون  الـتـثـبـت  والت�أكد  من\nالـم{ستـندات الـمتعلقة بها وفقًا للإجراءات الـمتبعة فـي هذا ال|ش�أن بـ~ضـرورة\nوجـود طلب ومــ�ؤيدات لل}صرف، وفــق الثابت بالتحقيقات.\n\t حـــال ارتـــكـــابـــه للــجـــرم �أولاً ، تــعــدى عــلـــى الـمــال الــعـــام ومل يـــــراعِ -2\n.حـــرمــتــــه والـمحافظــــة عليه، وفـق الــثــــابــت بالأوراق\nاثنا ع|شر: بالن{سبة للمتهم ال{ساد6س ع|شر/.....:\n\t غـ{سـل �أمـوالاً غـيـــر م|شروعــة الـم}صدر مع علمه ب�أنـها عــائدات جرمية، وذلك -1\n  حمل- ب�أن ا6ستبدل، وحول الأموال الـمتح}صل عليها من جرمية االختال6س\n بق}صد تـمـويه و�إخفاء طبيعة وم}صدر تلك العائدات، حيث - ًااالتهام �أول\nا6ستبدل 7شكــل الأموال النقدية الـمختل{سة بالعديد من العقارات والـمنقوالت\nوالـمركبات والـ{سندات الـمالية، وذلك بعد �أن ت{سلمها من �أخـيه الـمتــهم الأول\n\n– 378 –\n (.....)، والـمتــهم الثاين (.....)، ليقوم ب�إيداعها فـي ح{سابه ال|شخ}صــي لدى\nالبنك .....، والذي قام ب�إن|شائه خـ}صي}صً ا لإيداع الأمــوال غــيـــر الـم|شروعـــة\nحمل جرمية االختال6س، ومن ثم يقوم بتدوير تلك الأموال فـي عدة ح{سابات\nباال7شـتـــراك مع الـمتــهم ال{سابع ع|شر (.....)، من �أجل ا6ستخدامــها و�إعادة\nمتلكها من قبل الـمتـهميـــن الأول والثاين (.....، و.....)، يف 8صورة ا6ستثمارات\nو�أن|شطة عقارية ومنقوالت و6سندات مالية بداخل ال{سلطنة وخارجـها، ف~ ضلاً\nعن حتويله جزءًا من الأموال غـيـــر الـم|شروعة �إلـى خارج ال{سلطـنــة عــبــــر\nالــبــنــك.....، من �أجل 7شراء الـعــديــد من العقارات واال6ستثمارات وال{سندات\nفـي كل من جمهورية م}صر العربية ودولة الإمارات العربية الـمتـحـدة ومملـكـة\n)  الأمــريــكــيــة،  ليتم �إيداع  قيمة HP(  البحرين  ودولة  الكـويت  و7شركـة\nوعوائد تلك اال6ستثمارات يف ح{سابات خـــارجية، بهدف م{ساعدة الـمتــهميــن\nالأول والثاين فـي الإفالت من العقاب، الأمر الذي ك|شفت عنه التحقيقات،\nوالثابت قيمةً وتف}صيلاً بك|شف الـممتلكـات حمل الـم}صادرة الـمرفـق.\n\t غـ{سـل �أمـوالاً غـيـر م|شروعة الـم}صدر يعلم ب�أنها غـيــر م|شروعة، وذلك ب�أن موه -2\n و�أخفى طبيعة وم}صدر وملكية وحركـة الأموال غـيـر الـم|شروعة والـمتح}صل\n، حيث ا6ستلم العديد من - ًا حمل االتهام �أول- عليها من جرمية االختال6س\n ر. 14,000,000( الـمبالغ النقدية من �أخيه الـمتـهم الأول (.....) جتاوزت\nع) الأربعة ع|شر مليون ريال عماين، وذلك بهدف �إخفاء ومتويه حركــة تلك\nالأموال وم}صدرها، عن طريق �إيداعها يف ح{سابه البنـكـــي الـخـا8ص لدى البنك\n.....،  لي~ضفي  عليـها  8صفة  الـم|شروعية،  وك�أنها  نتاج �أعمال  جتارية  خا8صة\nبه، ليتوىل بعدها �إدارة تلك الأموال با6سمه الـخـا8ص حتت غطاء 7شركــتــه\n �أخ الـمتـهم الثاين)، - .....( (.....)، و7شركـــة (.....) الـمملوكـة للمتـهم\nعن طريق 7شراء وبناء العديد من العقارات والـمركبات واال6ستثمارات داخـل\nال{سلطنة وخارجـها ل}صالــح الـمتـهمـيـــن الأول والثاين (.....، و.....)، ف~ ضلاً\nعن �إن|شائه 7شركة حتـت مـ{سـمـــى (..... لال6ستثمار والأعمال) 6سُ ـجـلــت با6ســمه\nوالـمتــهم (.....)، والـمدعو (.....)، وذلك بناءً على طلب الـمتــهــميـــن (الأول\nوالثاين)، وا6ستخدمــت كغطاء لتمرير وحتويل الأموال غــيــــر الـم|شــروعــة\nمـحــل جرمية االختال6س �إلـى خــارج ال{سلطنة، لـ|شـراء وتوفــيـــر الــرخـــام\nوالــ{ســيــــرامــيـــك الـــالزم لبناء العقارات الــخــا8صة بـهم فـي كــل من 8صـحـار\nوم{سـقط و7شنا8ص، ف~ ضلاً عن دخولــه فـي 7شراكـــة بالباطن ب|شركــة (.....)\n\n– 379 –\n ،الـم{سـجلــة با6سم الـمتـهم الثامن ع|شر (.....)، بناء على طلب الـمتـهم الأول\nوذلك بهدف قطع 8صلة الـمال مب}صدره، وكيفية حركــته وملكيــته وعالقته\nبالـمتــهميـــن (الأول والثاين)، الأمـــر الذي ك|شفت عنه التحقيقات، والثابت\nقيمةً وتف}صيلاً بــك|شـــف الــممتلــكــــات مــحـــل الـم}صــادرة الـمـرفـــــق.\n\t غــ{ســل �أمـــــوالاً  غــيــر  مــ|شروعــــة  الـم}صدر  مع  عــلــمـــه  ب�أنــها  عــائــدات -3\n جــريــمــــة، وذلك ب�أن متلك وحاز وا6ستـخــدم الأموال الـمتح}صل عليـها من\nجرمية  االختال6س،  حـيـث  ا6ستــلــم  الـمـبالــغ  غــيـــر  الـم|شـروعـــة  نقدًا  من\n�أخـيــه الـمـتــهم الأول (.....)، وحازها فـي ح{ساباته البنكية، وظهر عليـها\nمبظهر الـمالك، وقام بتدويرها والت}صرف فيـها فـي 8صورة 7شراء ا6ستثمارات\nو�أن|شطة عقارية ومنقوالت و6سندات مالية بداخل ال{سلطنة وخارجـها، ل}صـالـح\nالـمتــهـميـن الأول والثاين، كما حول جزءًا منــها لبع~ض موظفـي وزارة .....،\nوفق الـمبـيـــّن و8صفـًا وقيمةً فـي الأوراق، ف~ ضلاً عن ت{سـجيـله جزءًا كبريا من\nالعقارات وال{سندات با6سمه ال|شـخـ}صـي، لغايات �إخفاء ومتويه م}صدر الأموال\nومـلكـيـــتــها، وقطع 8صلتـها بالـمتـهمـيـــن 6سالفي الذكر، الأمر الذي ك|شفت عنه\nالتحقيقات،  والثابت  قيمةً  وتف}صيلاً  بـك|شــف  الـممتلكــات  مـحـل  الـم}صادرة\nالـمرفق.\nثالثة ع|شر: بالن{سبة للمتهم ال{سابع ع|شر/.....:\n\t غــ{ســل �أمــوالاً غــيـــر م|شروعة الـم}صدر كــان يـ|شتـبـــه ب�أنـهــا عائدات جرمية، -1\n ،وذلك  ب�أن  مــوه  و�أخفى  الأموال  الـمتح}صل  عليــها  من  جـريــمة  االختال6س\nبق}صد �إخفاء الطبيعة احلقيقية للأموال وم}صدرها وملكيتــها وحركتــها، وذلك\nب�أن اتفق مع الـمتـهـم ال{ساد6س ع|شر (.....)، على �أن يقوم بتحويل الأمـوال\nغـيــر الـم|شروعة �إىل ح{ساب 7شركة (.....)، ومن ثم يقوم مالك ال|شركـة 6سالفة\nالذكر بتحويلها �إلـى ح{سابه ال|شـخ}صـــي (.....)، وذلك من �أجل ا6ستخدام\nتلك الأموال فـي 7شراء الأدوات والـمعدات الالزمة لبناء العقارات الـخـا8صـة\nبالـمتـهـميـن الأول والثاين (.....، و.....)، لغايات �إخفاء طبيعة الـمال وملكيته\nوحركــته، وقد ا6ستلم الـمتهم مبوجب تلك العملية عدة مبالغ مالية جتاوزت\n6سبعمائة �ألف ريال عماين، ف~ ضلاً عن اتفاقه مع الـمتـهم ال{ساد6س ع|شر (.....)،\nعلى �إن|شاء عقد وهـمـي يـهـدف �إىل دخول الأخــيــــر معه كرئيــ{س تنفيذي يف\n7شركـتـه (.....)، وحــرر له جمموعة من العقود با6سم 7شركته و6سلمها له بهدف\n\n– 380 –\n توقيعها لتغطية م}صدر وطبـيعــة الأمـــوال غــيـــر الــم|شروعـــة، ولـم{ساعــدة\nالــمتــهمـيـــن (الأول والثاين) من �إخفاء عائدات جرمية االختال6س والإفالت\nمن العقاب، الأمــــــر الــذي كــ|شـفــت عــنـــه الـــتــحــقيــقـــات، والثابـــت قيمةً\nوتــفــ}صيــلاً بكـــ|شـــف الـمــمـتلـــكـــــات مــــحـــــل الــمـــ}صــــادرة الــمــــرفـــــق.\n\t غــ{ســـل �أمـــــوالاً غــــيــــر مــ|شــروعـــة الـم}صــــدر كـــان يـ|شتبه ب�أنــها عائدات -2\n ،جرمية،  وذلك  ب�أن  م