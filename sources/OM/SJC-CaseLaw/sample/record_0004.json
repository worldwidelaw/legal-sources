ــاهـــا بيــنـــهــــما، و6ساعده على ت{ســهــيــــل �إمتام\nالـجــريــمــة 6سالــفــة الذكـــر، ب�أن ر7شــح وزكــى تــولـــي الــمــتــهــمــيــــــن الرابع\nواخلـامــ{ســة والــ{ســـاد6س والــتــا6ســـع والـعــا7شرة فـي الـمنا8صــب الــقــيــاديـــة\nالــتــي  يـ|شغلونــها  حاليًّا  لدى  دائرة  الإيــرادات  والـم}صــروفــات،  ودائـــرة\nالــمـــوازنــــة، ودائـــرة التدقيـــق الداخلــــي، بهدف تــمــريرهــم الــمعــامــــالت\nالــمــتــعلقـــة بالــمــبــالـــغ مــحــل جـــريــمـــة االختـــال6س، الأمـــر الذي مكنــهما\nمن اال6ستيالء عـلـى الــمبالـــغ الــمبينــــة بو8صف التــهمة الأولــــى، وفق الثابت\nبالتحقيقات.\n\t غــ{ســل �أمـــوالاً غيـر مـ|شـروعـة الـم}صدر يعلم ب�أنـها عـائدات جـرمية االختال6س -2\n مـحـل القرار، وذلك ب�أن ا6ستبدل، وحول الأمـوال الـمتح}صل عليها من جرمية\n بق}صد تـمـويـه و�إخفاء طبيعة وم}صدر تلك - ًا حمل االتـهام �أول- االختال6س\nالعائدات،  حيث  ا6ستبدل  7شكــل  الأمــوال  النقدية  الـمختلــ{سة  بالعديد  من\nالـعـقارات والـمنقــوالت والـمركبات وال{سندات الـمالــيــة، عـبـر تـمـريــرهـا �إىل\nالـمـتـهــم ال{ساد6س ع|شر (.....)، ليقوم ب�إيداعها يف ح{سابه الـ|شـخ}صــي لدى\nالبنك .....، والذي مت �إن|شا�ؤه خ}صي}صً ا لإيداع الأمـوال غـيـــر الـمـ|شــروعــة\nمــحــل جرمية االختال6س، ومن ثم يـقـوم الأخـيـــر بتدويـر تلك الأمـوال فـي\n �أخ الـمتـهم - .....( عـدة حـ{ســابــات باال7شتـــراك مع الـمـتــهـــم ال{سابـع ع|شر\nالثاين)، من �أجل ا6ستخدامـهـا، و�إعادة متلـكـهـا من قبل الـمتـهـمــيـن الأول والثاين\n(.....، و.....)، فـي 8صورة ا6ستثمارات و�أن|شطة عقارية ومنقوالت و6سندات\nمالية بداخل ال{سلطنة وخارجـها، ف~ ضلاً عن حتويله جـزءًا من الأمـوال غـيـــر\nالـمـ|شــروعـــة �إلـى خـارج الـ{سلطنـــة عـبـــر الـبنك.....، من �أجل 7شراء العديد\nمن العقارات واال6ستثمارات والــ{سنـــدات فـي كل من دولة الإمارات العربية\n) الأمــريكية، ليتم HP( الـمتحدة، ومملكة البحرين، ودولة الكويت، و7شركة\n�إيداع قيمة وعوائد تلك اال6ستــثمارات يف حــ{سابات خـــارجيـــــة، الأمــــر الذي\nك|شفـــت عنه التحقيقات، والثابت قيمةً وتف}صيلاً بكــ|شــف الـمـمتلكــــات مـحــل\nالــم}صـــا